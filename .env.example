# Copy to .env and fill in. .env is gitignored and loaded automatically by just.
#
# Signing key for JWTs. Minimum 32 characters. When unset the app generates an
# ephemeral key at startup and warns: tokens then stop working on restart.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Host port the app is published on for local runs (default 18080).
HOST_PORT=18080
